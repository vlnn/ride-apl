;;; ride-apl-session-eval-test.el --- Eval capture + value tips, pure -*- lexical-binding: t; -*-

(require 'ert)
(require 'ride-apl-session)
(require 'ride-apl-test-common)

(defun ride-apl-eval-test--ready-session ()
  (car (ride-apl-test--fold (ride-apl-test--connected-session)
                        '(("ReplyGetLog" . ((result . ())))
                          ("SetPromptType" . ((type . 1)))))))

(defun ride-apl-eval-test--effects-named (name effects)
  (seq-filter (lambda (effect) (eq (car effect) name)) effects))

(ert-deftest ride-apl-session-origin-line-sends-text-only ()
  (pcase-let ((`(,state . ,effects)
               (ride-apl-test--fold (ride-apl-eval-test--ready-session)
                                '((:input (("2+2" . my-origin)))))))
    (ert-info ("the Execute payload should carry the text, not the origin")
      (should (equal (ride-apl-proto-arg
                      (ride-apl-proto-parse (cadr (assq :send effects))) 'text)
                     "      2+2\n")))
    (ert-info ("sending an origin-tagged line should start a capture")
      (should (eq (ride-apl-session-eval-origin state) 'my-origin)))))

(ert-deftest ride-apl-session-plain-line-starts-no-capture ()
  (pcase-let ((`(,state . ,_)
               (ride-apl-test--fold (ride-apl-eval-test--ready-session)
                                '((:input ("2+2"))))))
    (ert-info ("a plain string line should not start a capture")
      (should (null (ride-apl-session-eval-origin state))))))

(ert-deftest ride-apl-session-capture-skips-echoed-input ()
  (pcase-dolist (`(,desc ,type ,captured)
                 '(("normal output" 2 t)
                   ("error output" 3 t)
                   ("quad output" 7 t)
                   ("echoed input" 11 nil)
                   ("echoed multiline input" 14 nil)))
    (pcase-let ((`(,state . ,_)
                 (ride-apl-test--fold
                  (ride-apl-eval-test--ready-session)
                  `((:input (("f 1" . o)))
                    ("AppendSessionOutput" . ((result . "x\n")
                                              (type . ,type) (group . 0)))))))
      (ert-info ((format "capture of type %s (%s) should be %s"
                         type desc (if captured "kept" "skipped")))
        (should (equal (not (null (ride-apl-session-eval-entries state)))
                       captured))))))

(ert-deftest ride-apl-session-prompt-finishes-capture ()
  (pcase-let ((`(,state . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '((:input (("2+2" . o1)))
                  ("AppendSessionOutput" . ((result . "      2+2\n")
                                            (type . 14) (group . 0)))
                  ("AppendSessionOutput" . ((result . "4\n")
                                            (type . 2) (group . 0)))
                  ("SetPromptType" . ((type . 1)))))))
    (ert-info ("SetPromptType>0 should emit one :eval-result for the origin")
      (should (equal (ride-apl-eval-test--effects-named :eval-result effects)
                     '((:eval-result o1 (("4\n" 2 0)) nil)))))
    (ert-info ("finishing should clear the capture")
      (should (null (ride-apl-session-eval-origin state)))
      (should (null (ride-apl-session-eval-entries state))))))

(ert-deftest ride-apl-session-busy-prompt-keeps-capturing ()
  (pcase-let ((`(,state . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '((:input (("⎕←1" . o)))
                  ("SetPromptType" . ((type . 0)))
                  ("AppendSessionOutput" . ((result . "1\n")
                                            (type . 7) (group . 0)))))))
    (ert-info ("SetPromptType 0 should not finish the capture")
      (should (null (ride-apl-eval-test--effects-named :eval-result effects)))
      (should (eq (ride-apl-session-eval-origin state) 'o))
      (should (equal (ride-apl-session-eval-entries state) '(("1\n" 7 0)))))))

(ert-deftest ride-apl-session-had-error-fails-capture ()
  (pcase-let ((`(,state . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '((:input (("1÷0" . o1) ("never" . o2)))
                  ("AppendSessionOutput" . ((result . "DOMAIN ERROR\n")
                                            (type . 3) (group . 0)))
                  ("HadError" . nil)))))
    (ert-info ("HadError should emit an error-flagged :eval-result")
      (should (equal (ride-apl-eval-test--effects-named :eval-result effects)
                     '((:eval-result o1 (("DOMAIN ERROR\n" 3 0)) :error)))))
    (ert-info ("HadError should clear the queue and the capture")
      (should (null (ride-apl-session-pending-lines state)))
      (should (null (ride-apl-session-eval-origin state))))))

(ert-deftest ride-apl-session-queued-origins-capture-in-turn ()
  (pcase-let ((`(,_ . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '((:input (("a←1" . o1) ("a+1" . o2)))
                  ("SetPromptType" . ((type . 1)))
                  ("AppendSessionOutput" . ((result . "2\n")
                                            (type . 2) (group . 0)))
                  ("SetPromptType" . ((type . 1)))))))
    (ert-info ("each origin should get its own result, in order")
      (should (equal (ride-apl-eval-test--effects-named :eval-result effects)
                     '((:eval-result o1 nil nil)
                       (:eval-result o2 (("2\n" 2 0)) nil)))))))

(ert-deftest ride-apl-session-value-tip-round-trip ()
  (pcase-let ((`(,_ . ,effects)
               (ride-apl-test--fold (ride-apl-eval-test--ready-session)
                                '((:value-tip 0 7 "a←⍳3" 0)))))
    (let ((sent (ride-apl-proto-parse (cadr (assq :send effects)))))
      (ert-info (":value-tip should send GetValueTip with win/token/line/pos")
        (should (equal (car sent) "GetValueTip"))
        (should (equal (ride-apl-proto-arg sent 'win) 0))
        (should (equal (ride-apl-proto-arg sent 'token) 7))
        (should (equal (ride-apl-proto-arg sent 'line) "a←⍳3"))
        (should (equal (ride-apl-proto-arg sent 'pos) 0)))))
  (pcase-let ((`(,_ . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '(("ValueTip" . ((token . 7) (class . 2)
                                 (tip . ("1 2 3")) (startCol . 0) (endCol . 1)))))))
    (ert-info ("a ValueTip reply should surface as a :value-tip-reply effect")
      (should (equal (ride-apl-eval-test--effects-named :value-tip-reply effects)
                     '((:value-tip-reply ((token . 7) (class . 2)
                                          (tip . ("1 2 3"))
                                          (startCol . 0) (endCol . 1)))))))))


(ert-deftest ride-apl-session-multiline-prompt-drains-unprefixed ()
  (pcase-let ((`(,_ . ,effects)
               (ride-apl-test--fold
                (ride-apl-eval-test--ready-session)
                '((:input (("mean←{" . o1) ("(+⌿⍵)÷≢⍵" . o2) ("}" . o3)))
                  ("SetPromptType" . ((type . 3)))
                  ("SetPromptType" . ((type . 3)))
                  ("SetPromptType" . ((type . 1)))))))
    (let ((texts (mapcar (lambda (effect)
                           (ride-apl-proto-arg (ride-apl-proto-parse (cadr effect)) 'text))
                         (ride-apl-eval-test--effects-named :send effects))))
      (ert-info ("the first line should carry the type-1 six-space prompt prefix")
        (should (equal (car texts) "      mean←{\n")))
      (ert-info ("lines drained under prompt type 3 should be sent unprefixed, in order")
        (should (equal (cdr texts) '("(+⌿⍵)÷≢⍵\n" "}\n")))))))

(provide 'ride-apl-session-eval-test)
;;; ride-apl-session-eval-test.el ends here
